FROM ghcr.io/openclaw/openclaw:latest

# Install gog (gogcli) — Google Suite CLI for Gmail, Calendar, Drive, Contacts.
# Source: https://github.com/openclaw/gogcli (maintained by the OpenClaw org)
# Pin the version for reproducible builds; check releases page to update.
ARG GOG_VERSION=0.34.0
USER root
RUN curl -fsSL \
      "https://github.com/openclaw/gogcli/releases/download/v${GOG_VERSION}/gogcli_${GOG_VERSION}_linux_amd64.tar.gz" \
    | tar -xzO gog > /usr/local/bin/gog \
  && chmod +x /usr/local/bin/gog \
  && test -x /usr/local/bin/gog

# Install Azure CLI for agent-managed Azure resource provisioning
RUN curl -sL https://aka.ms/InstallAzureCLIDeb | bash

USER node
